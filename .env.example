# 复制为 .env 后填入自己的值（.env 已被 .gitignore 排除）
AMAP_KEY=
QWEATHER_HOST=
QWEATHER_KEY=

# ── AI（可选，但参赛必须有）────────────────────────────
# 任何 OpenAI 兼容端点都行，换厂商只改这三行。
# 没配置时系统自动退回规则解析，功能降级但可用，界面上会标明"规则解析"。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 其他可选：
#   通义千问   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#   智谱 GLM   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4                 LLM_MODEL=glm-4-flash
#   Kimi       LLM_BASE_URL=https://api.moonshot.cn/v1                          LLM_MODEL=moonshot-v1-8k
